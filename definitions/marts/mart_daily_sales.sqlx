config {
  type: "table",
  schema: "analytics",
  tags: ["sales"],
  description: "Daily sales of completed orders by channel and customer country. Only runs if the upstream assertions pass.",
  dependOnDependencyAssertions: true,
  bigquery: {
    partitionBy: "order_date",
    clusterBy: ["country_code", "channel"]
  },
  columns: {
    order_date: "Order date (UTC).",
    channel: "Sales channel.",
    country_code: "Customer country.",
    orders_count: "Completed orders.",
    units_sold: "Units across completed orders.",
    net_revenue: "Revenue after discounts.",
    avg_order_value: "Net revenue per order."
  }
}

SELECT
  DATE(f.order_ts) AS order_date,
  f.channel,
  c.country_code,
  COUNT(*) AS orders_count,
  SUM(f.units) AS units_sold,
  SUM(f.gross_revenue) AS gross_revenue,
  SUM(f.discount_amount) AS discount_amount,
  SUM(f.net_revenue) AS net_revenue,
  ROUND(SAFE_DIVIDE(SUM(f.net_revenue), COUNT(*)), 2) AS avg_order_value
FROM ${ref("fct_orders")} AS f
JOIN ${ref("dim_customers")} AS c
  ON f.customer_id = c.customer_id
WHERE f.status = 'completed'
GROUP BY 1, 2, 3

-- post_operations run after the table is (re)built: handy for grants, labels or notifications.
post_operations {
  ALTER TABLE ${self()} SET OPTIONS (labels = [("managed_by", "dataform"), ("layer", "mart")])
}
